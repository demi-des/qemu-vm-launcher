# --- Guest memory (GB), used by QEMU -m ---
RAM=8

# --- vCPU and CPU model (QEMU -smp, -cpu) ---
QEMU_SMP=2
QEMU_CPU=host

# --- Display (QEMU -vga, -display) ---
QEMU_VGA=std
QEMU_DISPLAY=sdl

# --- Pin QEMU to these host CPUs (taskset -c). Set to "off" to run QEMU without taskset. ---
QEMU_CPU_AFFINITY=2-4

# --- OVMF / Secure Boot firmware (paths on the host) ---
OVMF_CODE_FD=/usr/share/OVMF/OVMF_CODE_4M.secboot.fd
OVMF_VARS_TEMPLATE=/usr/share/OVMF/OVMF_VARS_4M.ms.fd

# --- volumes/: under os/ubuntu/ (this path). iso/ and tpm/: under repository root. ---
VOLUMES_DIR=volumes
ISO_DIR=iso
TPM_DIR=tpm

# --- Filename for copied Windows OVMF vars (inside TPM_DIR) ---
OVMF_VARS_WIN=OVMF_VARS_win11.fd
